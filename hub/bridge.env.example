# /srv/sireum/secrets/bridge.env (0600, owner sireum). Filled in by install-hub.sh.
BRIDGE_PUBLIC_URL=https://sireum-hub.TAILNET.ts.net
WORKER_TOKEN=
OPERATOR_TOKEN=
LEASE_TTL_SEC=120
EXECUTOR_LIMITS=claude=0,opencode=0
CLAIM_GRACE=10m
POLL_INTERVAL=30s
BUNDLE_MAX_MB=50

# Task source (unset = API-only, no kanban polling)
#SOURCE=kanban-ssh:sireum@HERMES_HOST_PUBLIC#/srv/sireum/secrets/kanban_ed25519
#SOURCE=github:adaptiv/tasks#/srv/sireum/secrets/github-issues.key
REMOTE_TAGGERS=

# Nomad
NOMAD_ADDR=http://TAILSCALE_IP:4646
NOMAD_TOKEN=
NOMAD_SERVERS=TAILSCALE_IP:4647
NOMAD_VERSION=
NOMAD_NODE_TOKEN=

# Runner image. Empty (default): each worker builds sireum-runner:local-<hash> from this
# hub's source — no registry. Set RUNNER_IMAGE only to use a registry image instead
# (REGISTRY = the hub's own plain-HTTP registry on the tailnet, if USE_REGISTRY=1).
REGISTRY=
RUNNER_IMAGE=
# External private registry (e.g. GHCR): read-only pull credentials given to enrolled workers.
REGISTRY_SERVER=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
SQUID_IMAGE=ubuntu/squid@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029

# Join codes: Tailscale OAuth client with the auth_keys scope, allowed to tag tag:sireum-worker
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=

DISCORD_WEBHOOK_URL=

# MCP for Hermes (Phase 7): separate listener serving only /mcp. Publish with
# `sireum-hub mcp funnel on` (Tailscale Funnel → https://<hub>.ts.net:8443/mcp).
MCP_LISTEN=127.0.0.1:8790
MCP_FUNNEL_PORT=8443
# Optional: only accept MCP calls whose X-Forwarded-For matches (e.g. hermes-host's public IP).
MCP_ALLOW_IPS=
