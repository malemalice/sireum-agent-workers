# /srv/sireum/secrets/bridge.env (0600, owner sireum). Filled in by install-hub.sh.
BRIDGE_PUBLIC_URL=https://sireum-hub.TAILNET.ts.net
WORKER_TOKEN=
OPERATOR_TOKEN=
LEASE_TTL_SEC=120
EXECUTOR_LIMITS=claude=0,opencode=0
CLAIM_GRACE=10m
POLL_INTERVAL=30s
BUNDLE_MAX_MB=50

# Task source (unset = API-only, no kanban polling)
#SOURCE=kanban-ssh:sireum@HERMES_HOST_PUBLIC#/srv/sireum/secrets/kanban_ed25519
#SOURCE=github:adaptiv/tasks#/srv/sireum/secrets/github-issues.key
REMOTE_TAGGERS=

# Nomad
NOMAD_ADDR=http://TAILSCALE_IP:4646
NOMAD_TOKEN=
NOMAD_SERVERS=["TAILSCALE_IP:4647"]
NOMAD_VERSION=
NOMAD_NODE_TOKEN=

# Images handed to new workers
REGISTRY=sireum-hub.TAILNET.ts.net:5000
RUNNER_IMAGE=sireum-hub.TAILNET.ts.net:5000/sireum-runner:base
SQUID_IMAGE=ubuntu/squid@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029

# Join codes: Tailscale OAuth client with the auth_keys scope, allowed to tag tag:sireum-worker
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=

DISCORD_WEBHOOK_URL=
