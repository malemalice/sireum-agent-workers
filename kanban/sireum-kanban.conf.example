# sireum-kanban.conf on hermes-host — for Hermes v0.22.7+ (`hermes kanban --help`).
# Placeholders: {card} {ttl} {text}. {HERMES} expands to HERMES below.
HERMES=/home/hermes/.local/bin/hermes
HERMES_HOME=/home/hermes/.hermes
MARKER=Sireum: remote
CLAIM_TTL=7200

LIST_JSON={HERMES} kanban list --json
SHOW_JSON={HERMES} kanban show {card} --json
CLAIM={HERMES} kanban claim {card} --ttl {ttl}
COMMENT={HERMES} kanban comment {card} --author sireum -- {text}
COMPLETE={HERMES} kanban complete {card} --force --result={text}
REQUEST_REVIEW={HERMES} kanban request-review {card} --force --summary={text}
BLOCK={HERMES} kanban block {card} --kind needs_input -- {text}
RECLAIM={HERMES} kanban reclaim {card} --reason={text}
EDIT_BODY={HERMES} kanban edit {card} --body={text}

# Opt-in marker is a body line. Optional body directives:
#   Repo: <alias>       Executor: auto|claude|opencode      Test: <target>
#   Base: <ref>         Timeout: <minutes>                  Class: standard|browser|heavy
